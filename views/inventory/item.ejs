<%- include('../partials/head') %>

<div class="item-page">
    <div class="item-page-card">
        <img class="item-page-image" src="https://placehold.co/200" alt="<%= item.itemname %>">
        <h1 class="item-page-title"><%= item.itemname %></h1>
        <p class="item-page-desc"><%= item.itemdesc %></p>
        <p class="item-page-price">Price: £<%= item.itemprice %></p>
        <p class="item-page-stock">In stock: <%= item.itemstock %></p>
        <p class="item-page-category">Category: <%= item.catname || "Uncategorized" %></p>

        <div class="item-page-actions">
            <a class="item-action item-action-update" href="/inventory/items/item/update/<%= item.itemid %>">Update</a>
            <a class="item-action item-action-delete" href="/inventory/items/item/delete/<%= item.itemid %>">Delete</a>
            <a class="item-action item-action-back" href="/inventory/items">Back</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>