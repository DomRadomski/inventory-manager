<%- include('../partials/head') %>

<div class="categories-page">
    <h1 class="categories-title">Categories</h1>

    <a class="category-action category-action-create" href="/categories/new">Create new category</a>

    <div class="categories-scroll">
        <% if (categories.length === 0) { %>
            <p class="categories-empty">No categories found.</p>
        <% } else { %>
            <% categories.forEach(function(category) { %>
                <div class="category-card">
                    <img class="category-card-image" src="https://placehold.co/200" alt="<%= category.catname %>">
                    <h2 class="category-card-name"><%= category.catname %></h2>
                    <p class="category-card-desc"><%= category.catdesc %></p>
                    <a class="category-action category-action-view" href="/categories/category/<%= category.catid %>">View</a>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>